# Campus agent settings. Copy to .env; only ANTHROPIC_API_KEY is needed to talk to the agent.

ANTHROPIC_API_KEY=                      # set a monthly spend limit in the Anthropic console first
CAMPUS_SECRET_KEY=                      # signs the session tokens; any long random string
# CAMPUS_MODEL=claude-haiku-5-5
# CAMPUS_NOW=2026-11-16T09:00           # pin the school clock (the evaluation does)

# Cost control
# CAMPUS_SESSION_BUDGET_USD=0.25
# CAMPUS_DAILY_BUDGET_USD=2.0

# Public demo: one private copy of the school per visitor
# CAMPUS_SANDBOX=1
# CAMPUS_VISITOR_MESSAGE_LIMIT=30
# CAMPUS_VISITOR_BUDGET_USD=0.15

# Operations
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:6006     # traces to Phoenix, Langfuse, Tempo…
# CAMPUS_RETENTION_DAYS=30
# CAMPUS_AUDIT_RETENTION_DAYS=365
# CAMPUS_DISABLED_TOOLS=send_announcement,cancel_event  # take tools out of service

# Optional agent features (off by default)
# CAMPUS_ESCALATION_MODEL=claude-sonnet-5-5             # takes over long or failing turns
# CAMPUS_CACHE_TTL=1h
# CAMPUS_CLARIFY_CHOICES=1
# CAMPUS_SKILLS=1

# Integrations (docs/integrations.md; docker-compose.integrations.yml starts local servers)
# CAMPUS_PUBLIC_URL=http://localhost:8002
# CAMPUS_OIDC_ISSUER=http://localhost:8080/realms/campus
# CAMPUS_OIDC_CLIENT_ID=campus-agent
# CAMPUS_SMTP_URL=smtp://localhost:1025
# CAMPUS_CALDAV_URL=http://campus:campus@localhost:5232/campus/agenda/
# CAMPUS_GLPI_URL=https://glpi.example/apirest.php
# CAMPUS_GLPI_APP_TOKEN=
# CAMPUS_GLPI_USER_TOKEN=
# CAMPUS_MOODLE_URL=https://moodle.example
# CAMPUS_MOODLE_TOKEN=
