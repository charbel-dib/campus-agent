# ============================================================
# Campus agent (campus_agent/) — agentic assistant of the fictional school
# ============================================================
# (REQUIRED for the agent) Claude API key. Set a monthly spend limit in the console first.
ANTHROPIC_API_KEY=
# Model: claude-haiku-5-5 (default, cheapest) or claude-sonnet-5-5
CAMPUS_MODEL=claude-haiku-5-5
# Optional effort for adaptive thinking: low, medium, high (empty = model default)
CAMPUS_EFFORT=
# Pin the school clock for demos and evaluation (empty = real time), e.g. 2026-11-16T09:00
CAMPUS_NOW=
# Signs the demo login tokens. Use a long random string in production.
CAMPUS_SECRET_KEY=change-me
# Cost guards (USD)
CAMPUS_SESSION_BUDGET_USD=0.25
CAMPUS_DAILY_BUDGET_USD=2
# Requests per minute per user on the agent endpoints
CAMPUS_RATE_LIMIT_PER_MINUTE=12
# Document search: bm25 (no dependency) or dense (E5 embeddings, needs sentence-transformers)
CAMPUS_DOCS_RETRIEVER=bm25

# ============================================================
# ENSTA Campus Assistant — Configuration (.env)
# Copie ce fichier en .env puis remplis les valeurs.
# ============================================================

# ============================================================
# Version 0, ENSTA RAG chatbot (app.py) only — not needed by the campus agent
# ============================================================
# ----------------------------
# OpenAI (required by app.py only)
# ----------------------------
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Modèle pour la génération (réponses)
OPENAI_MODEL=gpt-4o-mini

# ----------------------------
# Dataset / Index (RAG)
# ----------------------------
# Dossier racine du dataset (par défaut: ./ENSTA_DATASET)
# Laisser commenté pour utiliser le dossier du dépôt.
# ENSTA_DATASET=./ENSTA_DATASET
# FAISS_INDEX_PATH=./ENSTA_DATASET/04_index/ensta.faiss
# META_JSONL_PATH=./ENSTA_DATASET/04_index/ensta_meta.jsonl
# RELOAD_FLAG_PATH=./ENSTA_DATASET/04_index/reload.flag
RELOAD_EVERY_SECONDS=30


EMB_MODEL=intfloat/multilingual-e5-base
QUERY_PREFIX=query: 

# Retrieval
TOP_K=8
MIN_SCORE=0.84

# Optional reranking (see README, Evaluation)
# RERANK_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
# RERANK_POOL=30


MAX_HISTORY_TURNS=8
MAX_HISTORY_CHARS=6000


OPENAI_CONCURRENCY=6


APP_LOG_LEVEL=INFO          # INFO | WARNING | ERROR
SILENCE_UVICORN_LOGS=1      # 1 = réduit le bruit uvicorn, 0 = logs complets


SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=example@gmail.com
SMTP_PASS=xxxxxxxxxxxxxxxx
SMTP_FROM=example@gmail.com
SUPPORT_TO=charbel.dib@ensta.fr
SUPPORT_SUBJECT_PREFIX=[ENSTA Chatbot - Ticket]
